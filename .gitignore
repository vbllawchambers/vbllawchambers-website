# Dependencies
node_modules/
**/node_modules/

# Environment variables & secrets (CRITICAL)
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
secrets/
**/secrets/
*.pem
*.key

# Build outputs
dist/
**/dist/
build/
.output/

# Upstream Postiz source clone — Postiz runs from the prebuilt ghcr.io image.
# Only dynamicconfig/ was ever used, and it now lives in automation/temporal/dynamicconfig/.
automation/postiz-app-main/

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/

# IDE and Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo

# Operating System files
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Confidential Client Docs & Agreements
docs/
*.docx

# Live client will submissions — PII + privileged instructions. Never commit.
# (Seed/demo records live in automation/web/server.js INITIAL_SUBMISSIONS.)
automation/web/data/submissions.json
automation/web/data/submissions.backup*.json
automation/web/uploads/

# Media test assets - content belongs in Google Drive, not the repo
*.mp4
*.mov
*.webm

# Uploaded Client Documents
uploads/
**/uploads/*
!**/uploads/.gitkeep

# Supabase CLI scratch state. pooler-url embeds live DB credentials.
supabase/.temp/
