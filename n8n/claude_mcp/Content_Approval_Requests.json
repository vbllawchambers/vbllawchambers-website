    {
      "id": "d7c33668-ca63-41ed-aec5-81c47d73e841",
      "name": "Sticky Note b8694ba2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "content": "## Content Calendar sheet\n\nUses the SAME \"Content Calendar\" sheet as the \"Postiz Social Scheduler\" workflow. This workflow watches for Status = Pending Review, sends the admin an approval email, and writes back Status = Approved or Rejected. The publishing workflow only ever touches rows already marked Approved (or Retry Pending) - it never waits on anyone itself.",
        "color": 4
      }
    },
    {
      "id": "c9335515-358c-43f5-aae1-b97bcbeb04fb",
      "name": "Sticky Note 2f4f26e9",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        560
      ],
      "parameters": {
        "content": "Known timing limitation: Gmail Send and Wait pauses this loop iteration until the admin responds (or up to 2 hours). If several rows are Pending Review at once, later rows in the SAME run will not get their email sent until the earlier one is resolved. A fresh run 15 minutes later will still pick up any row not yet touched, so nothing gets permanently stuck - but a slow response can delay a later row's email.",
        "color": 3
      }
    },
    {
      "id": "21f8af2e-57e2-4e37-9eca-f2efb9fb7e5d",
      "name": "Sticky Note e9cab125",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        816
      ],
      "parameters": {
        "content": "Setup needed before activating: connect a Google Sheets OAuth2 credential and a Gmail OAuth2 credential on the relevant nodes, then set a row's Status to Pending Review when it is ready for sign-off.",
        "color": 6
      }
    }
