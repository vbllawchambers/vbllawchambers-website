# ==============================================================================
# Advocate Digital Presence & Social Automation Platform (.env.example)
# Client: Advocate in Kavali, Andhra Pradesh | Primary Focus: Will Drafting
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Service URLs & Settings
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# PUBLIC URLS -- the ONLY place a hostname should ever appear.
#
# Everything else (docker-compose, service-manager.ps1, OAuth callbacks, webhook
# base URLs) derives from these four values. To go to production, change only
# this block:
#   N8N_PUBLIC_URL=https://n8n.vbllawchambers.com
#   POSTIZ_PUBLIC_URL=https://postiz.vbllawchambers.com
#   WEB_PORTAL_PUBLIC_URL=https://app.vbllawchambers.com
#   TEMPORAL_UI_PUBLIC_URL=https://temporal.vbllawchambers.com
#
# No trailing slashes.
#
# After changing these, update the OAuth redirect URIs to match:
#   Google Cloud Console -> {N8N_PUBLIC_URL}/rest/oauth2-credential/callback
#   Meta / Pinterest / LinkedIn consoles -> their respective callback paths
# ------------------------------------------------------------------------------
N8N_PUBLIC_URL=http://localhost:5678
POSTIZ_PUBLIC_URL=http://localhost:4800
WEB_PORTAL_PUBLIC_URL=http://localhost:3300
TEMPORAL_UI_PUBLIC_URL=http://localhost:8080

# n8n Configuration
# N8N_HOST/PORT/PROTOCOL control how n8n binds inside its container --
# they are NOT the public address. Use N8N_PUBLIC_URL for that.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=advocate-kavali-n8n-secure-key-2026
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Advocate Content Portal (Express serves the React build + API on one port)
WEB_PORT=3300

# Postiz Configuration
# Host port only. The public URL comes from POSTIZ_PUBLIC_URL above.
POSTIZ_PORT=4800
POSTIZ_JWT_SECRET=advocate-kavali-postiz-jwt-secret-key-32chars-min-2026
POSTIZ_IS_GENERAL=true
POSTIZ_DISABLE_REGISTRATION=false
POSTIZ_API_LIMIT=100
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads

# Postiz API Key (generated inside Postiz UI -> Settings -> API Keys)
POSTIZ_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database & Infrastructure Credentials (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=postiz-password
POSTGRES_DB=postiz-db-local
DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
REDIS_URL=redis://postiz-redis:6379
TEMPORAL_ADDRESS=temporal:7233

# ------------------------------------------------------------------------------
# 3. Social Media Channel API Credentials (6 Target Platforms)
# ------------------------------------------------------------------------------

# --- [Platform 1]: Telegram (Bot Token from @BotFather) ---
# Easiest: 0 OAuth required, works immediately on localhost
TELEGRAM_BOT_NAME=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- [Platform 2 & 3]: Meta (Instagram Professional & Facebook Page) ---
# Single Meta Developer App serves both Instagram and Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- [Platform 4]: YouTube (Google Cloud Console -> YouTube Data API v3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- [Platform 5]: LinkedIn (LinkedIn Developer Portal) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- [Platform 6]: Pinterest (Pinterest Developer Portal) ---
# Postiz connects Pinterest via OAuth using CLIENT_ID + CLIENT_SECRET.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Optional Channels: X (Twitter) & Threads ---
X_URL=
X_API_KEY=
X_API_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# ------------------------------------------------------------------------------
# [OPTIONAL / DIRECT API RESERVED]
# Not consumed by Postiz or any n8n workflow, and intentionally NOT wired into
# docker-compose.yml. Postiz authenticates these platforms through OAuth using the
# client ID/secret pairs above. Populate these only if you build a direct
# platform-API integration that bypasses Postiz.
# ------------------------------------------------------------------------------
PINTEREST_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. AI & Content Automation Settings
# ------------------------------------------------------------------------------
# OpenRouter API key (Used in n8n to extract Date/Time & assist caption drafting)
OPENROUTER_API_KEY=
# OpenAI API key (Optional alternative)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Google Drive & Sheets Integration References
# Reference values only - these are entered directly into the Google Drive/Sheets
# nodes inside the n8n UI (along with the Google OAuth credential) and are not
# injected into any container via docker-compose.yml.
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=1t3A6BXYskPkAl_VxS5-NjSyzjLiNxv-B
GOOGLE_SHEET_ID=
