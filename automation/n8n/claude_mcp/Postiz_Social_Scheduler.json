    {
      "parameters": {
        "jsCode": "const MAX_RETRIES = 3;\nconst row = $('Loop Over Rows').item.json;\nconst fileId = $('Upload Media to Postiz').item.json.id;\nconst integrations = $('Get Postiz Integrations').all().map(i => i.json);\n\nconst platformCols = {\n  instagram: 'Instagram Status', facebook: 'Facebook Status', youtube: 'YouTube Status',\n  linkedin: 'LinkedIn Status', pinterest: 'Pinterest Status', threads: 'Threads Status',\n};\n\nconst requested = String(row.Platforms || '').toLowerCase().split(',').map(p => p.trim()).filter(Boolean);\nconst toAttempt = requested.filter(p => {\n  const col = platformCols[p];\n  const val = col ? (row[col] || '') : '';\n  return !val.startsWith('Posted');\n});\n\nconst skippedNow = [];\nconst attemptable = [];\nfor (const p of toAttempt) {\n  if (p === 'pinterest' && !(row['Pinterest Board ID'] && String(row['Pinterest Board ID']).trim() !== '')) {\n    skippedNow.push({ platform: 'pinterest', reason: 'Skipped - no Pinterest Board ID set on this row' });\n    continue;\n  }\n  attemptable.push(p);\n}\n\nconst unresolved = attemptable.filter(p => !integrations.find(i => i.identifier === p));\nconst usable = attemptable.filter(p => integrations.find(i => i.identifier === p));\n\nconst posts = usable.map(p => {\n  const integ = integrations.find(i => i.identifier === p);\n  const settings = { __type: p };\n  if (p === 'youtube') settings.type = 'public';\n  if (p === 'instagram') settings.post_type = 'post';\n  if (p === 'pinterest') settings.board = row['Pinterest Board ID'];\n  return { integration: { id: integ.id }, value: [{ content: row.Caption || '', image: [{ id: fileId }] }], settings };\n});\n\nreturn [{\n  json: {\n    hasPosts: posts.length > 0,\n    attempted: usable,\n    skippedNow,\n    unresolved,\n    payload: { type: 'schedule', date: row['Scheduled DateTime'], shortLink: false, tags: [], posts },\n  },\n}];"
      },
