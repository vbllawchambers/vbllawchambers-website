      "id": "77b3d611-e70b-457b-98f9-ea5bfb20a213",
      "name": "Create Postiz Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        128
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "BSquAuNCdsWxuNOO",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const MAX_RETRIES = 3;\nconst row = $('Loop Over Rows').item.json;\nconst buildResult = $('Build Post Payload').item.json;\nconst apiResult = $json;\nconst isError = !!(apiResult && apiResult.error);\nconst attemptedThisRound = buildResult.attempted || [];\n\nconst platformCols = {\n  instagram: 'Instagram Status', facebook: 'Facebook Status', youtube: 'YouTube Status',\n  linkedin: 'LinkedIn Status', pinterest: 'Pinterest Status', threads: 'Threads Status',\n};\n\nconst updatedStatuses = {};\nfor (const key of Object.keys(platformCols)) {\n  const col = platformCols[key];\n  const wasAttempted = attemptedThisRound.includes(key);\n  const skip = (buildResult.skippedNow || []).find(s => s.platform === key);\n  if (wasAttempted) {\n    updatedStatuses[col] = isError ? ('Failed: ' + (apiResult.error && apiResult.error.message ? apiResult.error.message : 'Postiz API error')) : 'Posted';\n  } else if (skip) {\n    updatedStatuses[col] = skip.reason;\n  } else {\n    updatedStatuses[col] = row[col] || '';\n  }\n}\n\nconst requested = String(row.Platforms || '').toLowerCase().split(',').map(p => p.trim()).filter(Boolean);\nconst allRequestedPosted = requested.length > 0 && requested.every(p => (updatedStatuses[platformCols[p]] || '').startsWith('Posted'));\n\nconst prevRetryCount = Number(row['Retry Count'] || 0);\nlet finalStatus, retryCount = prevRetryCount;\nlet scheduledDateTime = row['Scheduled DateTime'];\n\nif (allRequestedPosted) {\n  finalStatus = 'Posted';\n} else {\n  retryCount = prevRetryCount + 1;\n  if (retryCount >= MAX_RETRIES) {\n    finalStatus = 'Failed';\n  } else {\n    finalStatus = 'Retry Pending';\n    scheduledDateTime = new Date(Date.now() + 15 * Math.max(retryCount, 1) * 60000).toISOString();\n  }\n}\n\nconst errorNotes = [];\nif (isError) errorNotes.push('Postiz error: ' + (apiResult.error && apiResult.error.message ? apiResult.error.message : 'unknown'));\nfor (const s of (buildResult.skippedNow || [])) errorNotes.push(s.platform + ': ' + s.reason);\nif ((buildResult.unresolved || []).length > 0) errorNotes.push('No connected integration found for: ' + buildResult.unresolved.join(', '));\n\nreturn [{\n  json: {\n    'Content ID': row['Content ID'],\n    Status: finalStatus,\n    'Retry Count': retryCount,\n    'Posted At': finalStatus === 'Posted' ? new Date().toISOString() : (row['Posted At'] || ''),\n    'Scheduled DateTime': scheduledDateTime,\n    Error: errorNotes.join(' | '),\n    ...updatedStatuses,\n  },\n}];"
      },
